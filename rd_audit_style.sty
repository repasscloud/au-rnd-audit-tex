}

\titleformat{\section}{\Large\bfseries\color{RDNavy}}{\thesection.}{0.55em}{}
\titleformat{\subsection}{\large\bfseries\color{RDInk}}{\thesubsection}{0.55em}{}
\titleformat{\subsubsection}{\normalsize\bfseries\color{RDInk}}{\thesubsubsection}{0.55em}{}
\titlespacing*{\section}{0pt}{1.0em}{0.45em}
\titlespacing*{\subsection}{0pt}{0.9em}{0.35em}
\titlespacing*{\subsubsection}{0pt}{0.8em}{0.25em}

\newcolumntype{Y}{>{\RaggedRight\arraybackslash\hspace{0pt}}X}
\newcolumntype{C}[1]{>{\Centering\arraybackslash\hspace{0pt}}p{#1}}
\newcolumntype{L}[1]{>{\RaggedRight\arraybackslash\hspace{0pt}}p{#1}}
\newcolumntype{R}[1]{>{\RaggedLeft\arraybackslash\hspace{0pt}}p{#1}}

\pagestyle{fancy}
\fancyhf{}
\lhead{\textcolor{RDNavy}{R\&D Audit Documentation}}
\rhead{\textcolor{RDNavy}{\small \leftmark}}
\cfoot{\textcolor{RDInk}{\thepage\ of \pageref{LastPage}}}
\setlength{\headheight}{15pt}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}

\newcommand{\RDDocumentTitle}[1]{\def\@RDDocumentTitle{#1}}
\newcommand{\RDCompany}[1]{\def\@RDCompany{#1}}
\newcommand{\RDFY}[1]{\def\@RDFY{#1}}
\newcommand{\RDPreparedBy}[1]{\def\@RDPreparedBy{#1}}
\newcommand{\RDVersion}[1]{\def\@RDVersion{#1}}
\newcommand{\RDConfidentiality}[1]{\def\@RDConfidentiality{#1}}

\newcommand{\RDDefaultMeta}{%
  \RDDocumentTitle{R\&D Documentation}%
  \RDCompany{[Company Name]}%
  \RDFY{[Financial Year]}%
  \RDPreparedBy{[Prepared By]}%
  \RDVersion{v1.0}%
  \RDConfidentiality{Internal / Commercial-in-Confidence}%
}
\RDDefaultMeta

\newcommand{\RDTitlePage}{%
  \thispagestyle{empty}
  \begingroup
  \sloppy

  \begin{flushleft}
    {\fontsize{24}{28}\selectfont\bfseries\color{RDNavy}\@RDDocumentTitle\par}
    \vspace{0.55cm}
    {\large\color{RDInk}Australian research and development documentation template\par}
  \end{flushleft}

  \vspace{1.0cm}

  \noindent\colorbox{RDBand}{%
    \parbox{\dimexpr\textwidth-2\fboxsep\relax}{%
      \vspace{0.2cm}
      \begin{tabularx}{\linewidth}{@{}L{3.2cm}Y@{}}
      \textbf{Company} & \@RDCompany \\
      \textbf{Financial year} & \@RDFY \\
      \textbf{Prepared by} & \@RDPreparedBy \\
      \textbf{Version} & \@RDVersion \\
      \textbf{Classification} & \@RDConfidentiality \\
      \textbf{Generated} & \today \\
      \end{tabularx}
      \vspace{0.2cm}
    }%
  }

  \vfill

  \noindent\colorbox{RDSoft}{%
    \parbox{\dimexpr\textwidth-2\fboxsep\relax}{%
      \textbf{Purpose}\par
      This template is designed to support contemporaneous, technical, financial, and evidentiary records for Australian R\&D Tax Incentive claims. It is written to help maintain a clear audit trail from program-level uncertainty through to individual experiments, engineering effort, expenditure attribution, and claim-pack assembly.
    }%
  }

  \vfill
  \endgroup
  \clearpage
}

\newcommand{\RDMetaTable}{%
  \rowcolors{2}{white}{RDSoft}
  \begin{tabularx}{\textwidth}{L{4.0cm}Y}
  \rowcolor{RDBand}
  \textbf{Field} & \textbf{Entry} \\
  Company & [Company Name] \\
  ABN & [ABN] \\
  Financial year & [YYYY-YYYY] \\
  Program / project & [Program or Project Name] \\
  Document owner & [Name / Role] \\
  Review date & [Date] \\
  Evidence repository path & [Repository / Share / Folder] \\
  \end{tabularx}
  \rowcolors{2}{}{}
}

\newcommand{\RDCallout}[2]{%
  \vspace{0.25em}
  \noindent\fcolorbox{RDLine}{RDSoft}{%
    \parbox{\dimexpr\textwidth-2\fboxsep-2\fboxrule\relax}{%
      \textbf{#1}\par #2
    }%
  }
  \vspace{0.45em}
}

\newcommand{\RDAuditNote}[1]{%
  \vspace{0.25em}
  \noindent\fcolorbox{RDWarnLine}{RDWarn}{%
    \parbox{\dimexpr\textwidth-2\fboxsep-2\fboxrule\relax}{%
      \textbf{Audit note}\par #1
    }%
  }
  \vspace{0.45em}
}

\newcommand{\RDGoodPractice}[1]{%
  \vspace{0.25em}
  \noindent\fcolorbox{RDGoodLine}{RDGood}{%
    \parbox{\dimexpr\textwidth-2\fboxsep-2\fboxrule\relax}{%
      \textbf{Good record-keeping practice}\par #1
    }%
  }
  \vspace{0.45em}
}

