\newcommand{\RDPlaceholderTable}[2]{%
  \rowcolors{2}{white}{RDSoft}
  \begin{tabularx}{\textwidth}{#1}
  #2
  \end{tabularx}
  \rowcolors{2}{}{}
}

\newcommand{\RDSectionIntro}[1]{\noindent\textcolor{RDInk}{#1}\par\vspace{0.25em}}

\newcommand{\RDGitImportBlock}[2]{%
\subsection{#1}
\RDSectionIntro{Export a plain-text git log into the referenced file path, then compile this document. If the file exists, it will be included automatically.}
\begin{Verbatim}[fontsize=\small,frame=single]
## Example export command
## git -C /path/to/repo log --since="2025-07-01" --until="2026-06-30" \
##   --date=short --pretty=format:"%h | %ad | %an | %d | %s" > #2
\end{Verbatim}
\IfFileExists{#2}{\VerbatimInput[fontsize=\small,frame=single]{#2}}{\RDCallout{Pending evidence import}{Expected git evidence file: \texttt{#2}}}
}

\newcommand{\RDEndMatter}{%
  \clearpage
  \section*{Document control}
  \addcontentsline{toc}{section}{Document control}
